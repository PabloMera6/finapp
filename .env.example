# Copia este archivo a .env y rellena los valores.
# NUNCA subas el archivo .env real a git.

# --- PostgreSQL ---
POSTGRES_USER=finapp
POSTGRES_PASSWORD=CAMBIA_ESTA_CONTRASENA
POSTGRES_DB=finapp

# --- Backend / Auth ---
# Genera una clave aleatoria segura, por ejemplo con:
#   openssl rand -hex 32
SECRET_KEY=CAMBIA_ESTA_CLAVE_SECRETA

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CAMBIA_ESTA_CONTRASENA_DE_ADMIN

# En producción (detrás de HTTPS) pon esto a true
COOKIE_SECURE=false
ENVIRONMENT=development

# --- Frontend ---
# URL pública por la que el navegador del usuario llega al backend.
NEXT_PUBLIC_API_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:3000

# --- Puertos publicados en el host ---
BACKEND_PORT=8000
FRONTEND_PORT=3000
